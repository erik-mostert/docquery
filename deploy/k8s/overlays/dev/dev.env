# Template for dev.env, filled by deploy/scripts/deploy.ps1 from the Bicep outputs (committed: no secrets).
# Env vars outrank the vault in every host, so these identity-based connection strings win over the key-based
# ones the vault holds for local use; only ConnectionStrings:docquery (with the password) comes from the vault.
ConnectionStrings__keyvault=https://kv-docqry-dev-nl2vwrgy.vault.azure.net/
ConnectionStrings__documents=Endpoint=https://stdocqrydevnl2vwrgy.blob.core.windows.net/;ContainerName=documents
ConnectionStrings__servicebus=sb-docqry-dev-nl2vwrgy.servicebus.windows.net
ConnectionStrings__openai=Endpoint=https://oai-docqry-dev-nl2vwrgy.openai.azure.com/
