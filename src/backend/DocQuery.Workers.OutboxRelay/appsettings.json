{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Persistence": {
    "ApplyMigrationsOnStartup": false
  },
  "Outbox": {
    "PollInterval": "00:00:02",
    "BatchSize": 50
  },
  "Messaging": {
    "TopicName": "document-events"
  },
  "Resilience": {
    "ServiceBus": {
      "MaxRetryAttempts": 3,
      "BaseDelay": "00:00:00.500",
      "AttemptTimeout": "00:00:30",
      "FailureRatio": 0.5,
      "SamplingDuration": "00:00:30",
      "MinimumThroughput": 10,
      "BreakDuration": "00:00:30"
    }
  }
}
