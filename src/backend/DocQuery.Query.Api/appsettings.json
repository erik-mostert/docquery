{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "ApplyMigrationsOnStartup": false
  },
  "Querying": {
    "DefaultTopK": 5,
    "MaxTopK": 20,
    "ExcerptLength": 300,
    "MaxAnswerTokens": 800
  },
  "AzureOpenAI": {
    "EmbeddingDeployment": "text-embedding-3-small",
    "ChatDeployment": "gpt-5-mini"
  },
  "RateLimiting": {
    "Queries": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    }
  },
  "Resilience": {
    "AzureOpenAI": {
      "MaxRetryAttempts": 3,
      "BaseDelay": "00:00:01",
      "AttemptTimeout": "00:01:00",
      "FailureRatio": 0.5,
      "SamplingDuration": "00:01:00",
      "MinimumThroughput": 10,
      "BreakDuration": "00:00:30"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  }
}
